{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Serena: Reindex WordFilterPlus",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\.tools\\reindex_serena.ps1"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build"
		},
		{
			"label": "Build WordFilterPlus (Release)",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				".\\WordFilterPlus\\WordFilterPlus.csproj",
				"-c",
				"Release"
			],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"ElinGamePath": "${env:ElinGamePath}"
				}
			},
			"group": "build"
		}
	]
}